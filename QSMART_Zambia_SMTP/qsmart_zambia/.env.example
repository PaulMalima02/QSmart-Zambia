MAIL_PORT=587
MAIL_USERNAME=qsmartzambia@gmail.com
MAIL_PASSWORD=zbnajrahwjfjlzme
MAIL_DEFAULT_SENDER=QSMART ZAMBIA<qsmartzambia@gmail.com>
MAIL_USE_TLS=true

# Alternative: Resend
# Free tier without a verified domain can ONLY deliver to your Resend signup email.
# To send to every registration email, either verify a domain at resend.com/domains
# or use Gmail SMTP above.
#
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_DEFAULT_SENDER=QSMART Zambia <onboarding@resend.dev>
# MAIL_SERVER=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=

SMS_PROVIDER=log
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
FLASK_ENV=development
