SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///instance/qsmart.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
ADMIN_EMAIL=admin@qsmart.zm
MAX_ADMIN_ACCOUNTS=2

# ── SMS: Africa's Talking (Zambia) ───────────────────
# Start with sandbox, then switch to live credentials.
SMS_PROVIDER=africastalking
SMS_API_KEY=
SMS_USERNAME=sandbox
SMS_SENDER=QSMART
SMS_FROM_NUMBER=

# Local only (no real SMS): SMS_PROVIDER=log

# Twilio alternative:
# SMS_PROVIDER=twilio
# SMS_API_KEY=ACCOUNT_SID:AUTH_TOKEN
# SMS_FROM_NUMBER=+1XXXXXXXXXX

# ── Email: Resend (recommended) ──────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_DEFAULT_SENDER=QSMART Zambia <onboarding@resend.dev>

# Or SMTP instead of Resend:
# EMAIL_PROVIDER=
# RESEND_API_KEY=
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=you@gmail.com
# MAIL_USE_TLS=true

MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true

# Optional live tests for scripts/check_providers.py --send
# TEST_PHONE=+26097XXXXXXX
# TEST_EMAIL=you@example.com

# ── OTP ──────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RESET_TOKEN_EXPIRY_MINUTES=15

FLASK_ENV=development
